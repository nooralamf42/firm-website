# ───────── National Tally: payment links + admin panel ─────────
# Copy to .env.local (dev) / add in Vercel → Settings → Environment Variables (production).
# None of these are used by the public marketing pages.

# MongoDB (new database; collections paymentLinks, payments, paymentEvents are created automatically)
MONGODB_URI=
MONGODB_DB=nationaltally

# Public URL of the main site (used for payment links, ePay return + webhook URLs). No trailing slash.
SITE_URL=https://www.nationaltallytech.com

# Admin panel subdomain (hostname only). Must start with "admin." — e.g. admin.nationaltallytech.com
# Leave empty to switch the admin panel off completely (/admin then returns 404 everywhere).
ADMIN_HOST=admin.nationaltallytech.com
ADMIN_PASSWORD=
# Random string, 32+ chars, signs the admin login cookie. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_SESSION_SECRET=

# ePay (https://gtw.online-epayment.com) — from the portal's "My Business" page
EPAY_PUBLIC_KEY=
EPAY_TERNO=
# Business Private Key. When set, checkout parameters are encrypted so customers can't change the amount.
EPAY_PRIVATE_KEY=
# Only change for a different ePay environment
EPAY_GATEWAY_URL=https://gtw.online-epayment.com
# true = also accept ePay "test" transactions (status 9) as paid. Keep false in production.
EPAY_ALLOW_TEST=false

# Default currency pre-filled when creating a payment link (3-letter code)
DEFAULT_CURRENCY=AUD
